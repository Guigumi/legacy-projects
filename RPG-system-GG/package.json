{
  "name": "rpg-system-gg",
  "version": "1.3.0",
  "description": "Aplicativo desktop local para mestrar campanhas de RPG.",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "build:frontend": "npm --prefix frontend ci && npm --prefix frontend run build",
    "build:linux": "npm run build:frontend && npm --prefix backend ci --omit=dev && electron-builder --linux AppImage",
    "build:win": "npm run build:frontend && npm --prefix backend ci --omit=dev && electron-builder --win nsis",
    "build:all": "npm run build:frontend && npm --prefix backend ci --omit=dev && electron-builder -mwl"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Guigumi/RPG-system-GG.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Guigumi/RPG-system-GG/issues"
  },
  "homepage": "https://github.com/Guigumi/RPG-system-GG#readme",
  "devDependencies": {
    "electron": "^37.10.3",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "private": true,
  "build": {
    "appId": "com.guigumi.rpgsystemgg",
    "productName": "RPG System GG",
    "executableName": "rpg-system-gg",
    "artifactName": "RPG-System-GG-${version}-${arch}.${ext}",
    "directories": {
      "output": "release/electron"
    },
    "files": [
      "electron/**/*",
      "package.json",
      "!node_modules/.cache/**/*"
    ],
    "extraResources": [
      {
        "from": "backend/src",
        "to": "backend/src"
      },
      {
        "from": "backend/node_modules",
        "to": "backend/node_modules"
      },
      {
        "from": "backend/package.json",
        "to": "backend/package.json"
      },
      {
        "from": "backend/.env.example",
        "to": "backend/.env.example"
      },
      {
        "from": "frontend/dist",
        "to": "backend/public"
      }
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "icon": "build/icon.svg"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Guigumi",
        "repo": "RPG-system-GG",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.svg"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false
    }
  }
}
